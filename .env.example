# On-campus model endpoint: the campus orchestration node (ProBook, OpenAI-compatible API).
VITE_AOI_LLM_URL=http://192.168.1.10:8000/v1
# Default on-campus model id served by the campus orchestration node.
VITE_AOI_LLM_MODEL=aoi-general
# Research endpoint: also the campus orchestration node (receives anonymized prompts only).
VITE_AOI_EXTERNAL_URL=http://192.168.1.10:8000/v1
# Default research model id served by the campus orchestration node.
VITE_AOI_EXTERNAL_MODEL=aoi-scholar
